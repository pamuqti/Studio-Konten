# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare R2 (Object Storage Gratis 10GB & Zero Egress)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="ruang-konten-media"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Keamanan server
# HOST: default 127.0.0.1 saat dev, 0.0.0.0 saat production
# HOST="127.0.0.1"
# ALLOWED_ORIGINS: daftar origin tambahan yang boleh memanggil /api (pisahkan dengan koma)
# ALLOWED_ORIGINS="https://ruangkonten.web.app"
# TRUST_PROXY: isi jumlah hop proxy (mis. 1) bila server di belakang reverse proxy, agar rate limit membaca IP asli
# TRUST_PROXY="1"
# MAX_UPLOAD_MB: batas ukuran upload R2 (default 500)
# MAX_UPLOAD_MB="500"
